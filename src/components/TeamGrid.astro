---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  members.map(async (m) => ({ data: m.data, Content: (await render(m)).Content })),
);
---

<div class="team">
  {
    rendered.map(({ data, Content }) => (
      <article class="member">
        {data.photo && (
          <Image
            class="member__photo"
            src={data.photo}
            alt={data.name}
            width={440}
            format="webp"
            loading="lazy"
            style={`object-position:${data.photoPosition ?? '50% 30%'}`}
          />
        )}
        <div class="member__body">
          <h2>{data.name}</h2>
          <p class="member__role">
            {data.role}
            {data.location && <span class="member__loc"> · {data.location}</span>}
          </p>
          <div class="prose member__bio">
            <Content />
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .team {
    display: grid;
    gap: 2.5rem;
  }
  .member {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.75rem;
    align-items: start;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .member:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .member__photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-alt);
  }
  .member__body h2 {
    font-size: var(--step-2);
  }
  .member__role {
    margin-top: 0.35rem;
    color: var(--primary);
    font-weight: 700;
  }
  .member__loc {
    color: var(--text-muted);
    font-weight: 400;
  }
  .member__bio {
    margin-top: 1rem;
    font-size: var(--step--1);
  }
  .member__bio :global(p + p) {
    margin-top: 0.75em;
  }
  .member__bio :global(ul),
  .member__bio :global(ol) {
    line-height: 1.3;
  }
  /* a bold label ("Past Experience", "Education") sitting right on its list */
  .member__bio :global(p + ul),
  .member__bio :global(p + ol) {
    margin-top: 0.3em;
  }
  .member__bio :global(li + li) {
    margin-top: 0;
  }
  @media (max-width: 38rem) {
    .member {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .member__photo {
      max-width: 220px;
    }
  }
</style>
