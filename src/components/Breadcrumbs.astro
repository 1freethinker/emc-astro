---
import { getCollection } from 'astro:content';

interface Props {
  /** id of the current page entry in the `pages` collection */
  current: string;
}

const { current } = Astro.props;
const pages = await getCollection('pages');
const byId = new Map(pages.map((p) => [p.id, p]));

const trail: { href: string; label: string }[] = [];
let cursor = byId.get(current);
const guard = new Set<string>();
while (cursor && !guard.has(cursor.id)) {
  guard.add(cursor.id);
  trail.unshift({
    href: `/${cursor.id}`,
    label: cursor.data.navLabel ?? cursor.data.title,
  });
  cursor = cursor.data.parent ? byId.get(cursor.data.parent) : undefined;
}
trail.unshift({ href: '/', label: 'Home' });
---

{
  trail.length > 1 && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {trail.map((c, i) => (
          <li>
            {i < trail.length - 1 ? (
              <a href={c.href}>{c.label}</a>
            ) : (
              <span aria-current="page">{c.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .crumbs li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .crumbs li:not(:last-child)::after {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .crumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--link);
  }
  .crumbs [aria-current='page'] {
    color: var(--text);
  }
</style>
