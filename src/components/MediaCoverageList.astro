---
import { getCollection } from 'astro:content';

const items = (await getCollection('mediaCoverage')).sort((a, b) => a.data.order - b.data.order);
---

<ul class="coverage">
  {
    items.map(({ data }) => (
      <li class="coverage__item">
        <a class="coverage__link" href={data.url} rel="noopener">
          {data.title}
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
            <path
              d="M7 17 17 7M9 7h8v8"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
        <p class="coverage__meta">
          {data.titleKo && <span lang="ko">{data.titleKo}</span>}
          {data.titleKo && data.outlet && <span aria-hidden="true"> · </span>}
          {data.outlet && <span>{data.outlet}</span>}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .coverage {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .coverage__item {
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }
  .coverage__item:hover {
    border-color: var(--border-strong);
  }
  .coverage__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--text);
  }
  .coverage__link:hover {
    color: var(--link-hover);
  }
  .coverage__link svg {
    flex-shrink: 0;
    color: var(--text-muted);
  }
  .coverage__meta {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
