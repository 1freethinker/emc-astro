---
/**
 * A circular "wheel" graphic — numbered nodes evenly spaced on a ring around
 * a central hub — paired with a plain legend below it. The wheel is purely
 * decorative SVG math (positions trig'd out once at build time); the legend
 * carries the real text in normal document flow so it never has to fight
 * with absolute positioning for space on a narrow screen.
 */
interface Props {
  items: string[];
}
const { items } = Astro.props;

const colors = ['var(--rose-600)', 'var(--blue-600)', 'var(--teal-600)', 'var(--rose-400)', 'var(--blue-400)'];

const ringR = 34; // badge ring radius, % of container

const nodes = items.map((text, i) => {
  const angle = (-90 + (360 / items.length) * i) * (Math.PI / 180);
  const bx = 50 + ringR * Math.cos(angle);
  const by = 50 + ringR * Math.sin(angle);
  return { text, i, bx, by, color: colors[i % colors.length] };
});
---

<div class="wheel-wrap">
  <div class="wheel" aria-hidden="true">
    <svg class="wheel__svg" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r={ringR} class="wheel__track" />
      {nodes.map((n) => <circle cx={n.bx} cy={n.by} r="7.5" fill={n.color} />)}
      {
        nodes.map((n) => (
          <text x={n.bx} y={n.by} class="wheel__number">
            {n.i + 1}
          </text>
        ))
      }
    </svg>
    <div class="wheel__hub">
      <span>EMC&rsquo;s<br />Mission</span>
    </div>
  </div>

  <ol class="wheel-legend">
    {
      nodes.map((n) => (
        <li class="wheel-legend__item">
          <span class="wheel-legend__badge" style={`background:${n.color}`}>{n.i + 1}</span>
          <span>{n.text}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .wheel-wrap {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-block: clamp(1.5rem, 4vw, 2.5rem);
    justify-items: center;
  }
  @media (min-width: 40rem) {
    .wheel-wrap {
      grid-template-columns: minmax(0, 15rem) 1fr;
      align-items: center;
      gap: clamp(1.5rem, 5vw, 3rem);
    }
  }

  .wheel {
    position: relative;
    width: 100%;
    max-width: 15rem;
    aspect-ratio: 1;
  }
  .wheel__svg {
    width: 100%;
    height: 100%;
  }
  .wheel__track {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
  }
  .wheel__number {
    font-family: var(--font-display);
    font-size: 7px;
    font-weight: 600;
    fill: var(--primary-contrast);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .wheel__hub {
    position: absolute;
    inset: 26%;
    display: grid;
    place-items: center;
    text-align: center;
    border-radius: 50%;
    background: linear-gradient(160deg, var(--hero-from), var(--hero-to));
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.75rem, 4vw, 0.95rem);
    line-height: 1.25;
    color: var(--text);
  }

  .wheel-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    gap: 0.85rem;
  }
  .wheel-legend__item {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .wheel-legend__badge {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    color: var(--primary-contrast);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    transform: translateY(0.15em);
  }
</style>
