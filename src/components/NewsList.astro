---
import { getCollection } from 'astro:content';

// Drafts show in dev, hide in production builds.
const posts = (await getCollection('news', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

{
  posts.length === 0 ? (
    <p class="empty">No updates have been published yet.</p>
  ) : (
    <ul class="news">
      {posts.map((post) => (
        <li>
          <a href={`/whats-happening/${post.id}`}>{post.data.title}</a>
          <span class="meta">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            {post.data.draft ? ' · draft' : ''}
          </span>
          {post.data.description && <p class="excerpt">{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }
  .news a {
    font-weight: 600;
    font-size: 1.1rem;
  }
  .meta {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.2rem;
  }
  .excerpt {
    margin: 0.4rem 0 0;
  }
  .empty {
    color: var(--muted);
  }
</style>
