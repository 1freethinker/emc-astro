---
/**
 * EMC wordmark, rebuilt as clean SVG (from the low-res logo JPG).
 * - Rounded, playful display face (Baloo 2) for the "EMC" mark.
 * - A two-circle "mother & child" glyph echoing the favicon, in place of the
 *   original low-res globe-with-figures raster (which had a baked-in white box).
 * Theme-aware via CSS custom properties; scales to any size.
 */
interface Props {
  /** rendered height in px; width scales with it */
  height?: number;
  /** hide the small "EVERY MOTHER & CHILD" line (e.g. very tight spots) */
  tagline?: boolean;
  title?: string;
}
const { height = 40, tagline = true, title = 'EMC — Every Mother & Child' } = Astro.props;
const ratio = 182 / 44;
---

<svg
  class="logo"
  viewBox="0 0 182 44"
  width={Math.round(height * ratio)}
  height={height}
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <circle class="logo__dot logo__dot--big" cx="13" cy="24" r="11" />
  <circle class="logo__dot logo__dot--small" cx="27" cy="15" r="7" />

  <text
    x="44"
    y={tagline ? 33 : 35}
    class="logo__mark"
    font-family="var(--font-logo)"
    font-weight="800"
    font-size="34"
  >EMC</text>
  {
    tagline && (
      <text
        x="45"
        y="42"
        class="logo__name"
        font-family="var(--font-body)"
        font-weight="700"
        font-size="8.2"
        letter-spacing="1.55"
      >
        EVERY MOTHER &amp; CHILD
      </text>
    )
  }
</svg>

<style>
  .logo {
    display: block;
    height: auto;
  }
  .logo__dot--big {
    fill: var(--primary);
  }
  .logo__dot--small {
    fill: var(--secondary);
  }
  .logo__mark {
    fill: var(--primary);
  }
  .logo__name {
    fill: var(--secondary);
  }
</style>
