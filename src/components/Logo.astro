---
/**
 * EMC wordmark: the brand's "globe with children" mark (from EMC's Facebook
 * page logo, background removed — see public/images/logo-mark.png) next to
 * the "EMC" / "EVERY MOTHER & CHILD" text, set in the same rounded display
 * face (Baloo 2) as before. Text stays real SVG `<text>` so it's crisp and
 * theme-aware; only the illustrated globe icon is a raster image.
 */
interface Props {
  /** rendered height in px; width scales with it */
  height?: number;
  /** hide the small "EVERY MOTHER & CHILD" line (e.g. very tight spots) */
  tagline?: boolean;
  title?: string;
}
const { height = 40, tagline = true, title = 'EMC — Every Mother & Child' } = Astro.props;
const ratio = 182 / 44;
---

<svg
  class="logo"
  viewBox="0 0 182 44"
  width={Math.round(height * ratio)}
  height={height}
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <image href="/images/logo-mark.png" x="1" y="7" width="30" height="28.5" />

  <text
    x="44"
    y={tagline ? 33 : 35}
    class="logo__mark"
    font-family="var(--font-logo)"
    font-weight="800"
    font-size="34"
  >EMC</text>
  {
    tagline && (
      <text
        x="45"
        y="42"
        class="logo__name"
        font-family="var(--font-logo)"
        font-weight="700"
        font-size="9"
        letter-spacing="0.4"
      >
        EVERY MOTHER &amp; CHILD
      </text>
    )
  }
</svg>

<style>
  .logo {
    display: block;
    height: auto;
  }
  .logo__mark {
    fill: var(--primary);
  }
  .logo__name {
    fill: var(--secondary);
  }
</style>
