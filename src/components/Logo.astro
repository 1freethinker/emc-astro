---
/**
 * EMC wordmark, rebuilt as clean SVG (from the low-res logo JPG).
 * - Rounded, playful display face (Baloo 2) for the "EMC" mark.
 * - Glyph: a taegeuk (Korean-flag swirl) — the two comma shapes double as a
 *   mother and child nestled together, and place EMC in Korea. Uses the brand
 *   rose + blue, which already sit close to the flag's colours.
 * Theme-aware via CSS custom properties; scales to any size.
 */
interface Props {
  /** rendered height in px; width scales with it */
  height?: number;
  /** hide the small "EVERY MOTHER & CHILD" line (e.g. very tight spots) */
  tagline?: boolean;
  title?: string;
}
const { height = 40, tagline = true, title = 'EMC — Every Mother & Child' } = Astro.props;
const ratio = 182 / 44;
---

<svg
  class="logo"
  viewBox="0 0 182 44"
  width={Math.round(height * ratio)}
  height={height}
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <g transform="rotate(210 16 22)">
    <path
      class="logo__swirl logo__swirl--rose"
      d="M16 9 A13 13 0 0 1 16 35 A6.5 6.5 0 0 1 16 22 A6.5 6.5 0 0 0 16 9 Z"
    />
    <path
      class="logo__swirl logo__swirl--blue"
      d="M16 35 A13 13 0 0 1 16 9 A6.5 6.5 0 0 1 16 22 A6.5 6.5 0 0 0 16 35 Z"
    />
  </g>

  <text
    x="44"
    y={tagline ? 33 : 35}
    class="logo__mark"
    font-family="var(--font-logo)"
    font-weight="800"
    font-size="34"
  >EMC</text>
  {
    tagline && (
      <text
        x="45"
        y="42"
        class="logo__name"
        font-family="var(--font-body)"
        font-weight="700"
        font-size="8.2"
        letter-spacing="1.55"
      >
        EVERY MOTHER &amp; CHILD
      </text>
    )
  }
</svg>

<style>
  .logo {
    display: block;
    height: auto;
  }
  .logo__swirl--rose {
    fill: var(--primary);
  }
  .logo__swirl--blue {
    fill: var(--secondary);
  }
  .logo__mark {
    fill: var(--primary);
  }
  .logo__name {
    fill: var(--secondary);
  }
</style>
