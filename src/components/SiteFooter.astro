---
import navData from '../data/navigation.json';
import site from '../data/site.json';
import Logo from './Logo.astro';
import FacebookIcon from './FacebookIcon.astro';
import type { NavData } from '../types/nav';

const nav = navData as NavData;
// Top-level items can be label-only (no href) — link to the first child's
// page instead, keeping the group's own label as the link text.
const footerLinks = nav.primary
  .map((item) => ({ label: item.label, href: item.href ?? item.children?.[0]?.href }))
  .filter((link): link is { label: string; href: string } => Boolean(link.href));

const year = new Date().getFullYear();
const tel = site.phone.replace(/[^0-9+]/g, '');
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a class="about__logo" href="/" aria-label={`${site.legalName}, home`}>
        <Logo height={44} />
      </a>
      {site.legalNameKo && <p class="about__ko">{site.legalNameKo}</p>}
      <p class="about__blurb">{site.description}</p>
    </div>

    <nav class="col" aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        {
          footerLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="col">
      <h2>Contact</h2>
      <ul>
        <li><a href={`tel:${tel}`}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.address}</li>
        <li>
          <a class="contact__social" href={site.social.facebook} target="_blank" rel="noopener noreferrer">
            <FacebookIcon size={16} />
            Facebook
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container fine">
    <p>&copy; {year} {site.legalName}. Founded {site.founded}.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-alt);
    border-top: 1px solid var(--border);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
    font-size: var(--step--1);
  }
  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1.6fr 1fr 1fr;
  }
  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 30rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .about__logo {
    display: inline-block;
  }
  .about__ko {
    margin-top: 0.6rem;
    color: var(--text-muted);
  }
  .about__blurb {
    margin-top: 0.6rem;
    color: var(--text-muted);
    max-width: 36ch;
  }
  .col h2 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .col a {
    color: var(--text);
    text-decoration: none;
  }
  .col a:hover {
    color: var(--link-hover);
  }
  .contact__social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .fine {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }
</style>
