---
import navData from '../data/navigation.json';
import site from '../data/site.json';
import Logo from './Logo.astro';
import FacebookIcon from './FacebookIcon.astro';
import type { NavData, NavItem } from '../types/nav';

const nav = navData as NavData;

const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href?: string) => {
  if (!href) return false;
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? here === '/' : here === h || here.startsWith(h + '/');
};
const inGroup = (item: NavItem) =>
  isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="EMC — Every Mother & Child, home">
      <Logo height={40} />
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="sr-only">Menu</span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary" data-nav>
      <ul class="menu">
        {
          nav.primary.map((item) => (
            <li class:list={['menu__item', { 'is-current': inGroup(item) }]}>
              {item.href ? (
                <a
                  class="menu__link"
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <span class="menu__link menu__link--label" tabindex="0">
                  {item.label}
                </span>
              )}
              {item.children && item.children.length > 0 && (
                <ul class="submenu">
                  {item.children.map((child) => (
                    <li>
                      <a
                        class="submenu__link"
                        href={child.href}
                        aria-current={isActive(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      <div class="nav-actions">
        <a
          class="social-link"
          href={site.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="EMC on Facebook"
        >
          <FacebookIcon size={20} />
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
  }
  .brand {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding-block: 0.4rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .primary-nav {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu__item {
    position: relative;
  }
  .menu__link {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: var(--step-0);
    text-decoration: none;
    white-space: nowrap;
  }
  .menu__link:hover {
    background: var(--surface-alt);
    color: var(--text);
  }
  .menu__link--label {
    cursor: default;
  }
  .menu__item.is-current > .menu__link {
    color: var(--primary);
  }
  .menu__item.is-current > .menu__link::after {
    content: '';
    display: block;
    height: 2px;
    background: var(--primary);
    border-radius: 2px;
    margin-top: 3px;
  }

  .submenu {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
  }
  .submenu__link {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: var(--step--1);
    text-decoration: none;
    white-space: nowrap;
  }
  .submenu__link:hover,
  .submenu__link[aria-current='page'] {
    background: var(--surface-alt);
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .social-link {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--text-muted);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .social-link:hover {
    background: var(--surface-alt);
    color: var(--primary);
  }

  .nav-toggle {
    display: none;
  }

  /* ---- Desktop dropdowns ---- */
  @media (min-width: 60rem) {
    .submenu {
      display: none;
      position: absolute;
      top: calc(100% + 0.4rem);
      left: 0;
      min-width: 12rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
    }
    /* hover bridge so the pointer can travel to the panel */
    .menu__item:hover::after {
      content: '';
      position: absolute;
      inset: 100% 0 auto 0;
      height: 0.6rem;
    }
    .menu__item:hover > .submenu,
    .menu__item:focus-within > .submenu {
      display: block;
      animation: dropdown-in 0.15s ease;
    }
    @keyframes dropdown-in {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
    }
  }

  /* ---- Mobile drawer ---- */
  @media (max-width: 59.99rem) {
    .nav-toggle {
      display: grid;
      place-items: center;
      margin-left: auto;
      width: 2.5rem;
      height: 2.5rem;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      background: var(--surface);
      cursor: pointer;
    }
    .nav-toggle__bars,
    .nav-toggle__bars::before,
    .nav-toggle__bars::after {
      content: '';
      display: block;
      width: 18px;
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: transform 0.2s ease;
    }
    .nav-toggle__bars::before {
      transform: translateY(-6px);
    }
    .nav-toggle__bars::after {
      transform: translateY(4px);
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle__bars {
      background: transparent;
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle__bars::before {
      transform: translateY(0) rotate(45deg);
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle__bars::after {
      transform: translateY(-2px) rotate(-45deg);
    }

    .primary-nav {
      position: fixed;
      inset: 64px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 1rem var(--gutter) 2rem;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
      max-height: calc(100dvh - 64px);
      overflow-y: auto;
      transform: translateY(-110%);
      transition: transform 0.25s ease;
    }
    .primary-nav.is-open {
      transform: translateY(0);
    }
    .menu {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .menu__link {
      padding: 0.85rem 0.5rem;
      font-size: var(--step-0);
      border-bottom: 1px solid var(--border);
    }
    .menu__item.is-current > .menu__link::after {
      display: none;
    }
    .submenu {
      padding: 0 0 0.5rem 1rem;
    }
    .submenu__link {
      padding: 0.6rem 0.5rem;
      font-size: var(--step--1);
    }
    .nav-actions {
      margin-top: 1.25rem;
    }
    .social-link {
      border: 1px solid var(--border-strong);
    }
  }
</style>

<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-nav-toggle]');
    const panel = document.querySelector('[data-nav]');
    if (!toggle || !panel) return;
    const set = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () =>
      set(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
    matchMedia('(min-width: 60rem)').addEventListener('change', () => set(false));
  })();
</script>
