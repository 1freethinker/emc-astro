---
import { getCollection, render } from 'astro:content';

const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  partners.map(async (p) => ({ data: p.data, Content: (await render(p)).Content })),
);
---

<ul class="partners">
  {
    rendered.map(({ data, Content }) => (
      <li class="partner">
        <div class="partner__logo">
          {data.logo ? (
            <img src={data.logo} alt={`${data.name} logo`} loading="lazy" />
          ) : (
            <span>{data.name}</span>
          )}
        </div>
        <div class="partner__body prose">
          <h2>
            {data.url ? (
              <a href={data.url} rel="noopener">
                {data.name}
              </a>
            ) : (
              data.name
            )}
          </h2>
          <Content />
        </div>
      </li>
    ))
  }
</ul>

<style>
  .partners {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .partner {
    display: grid;
    grid-template-columns: 168px 1fr;
    gap: 1.75rem;
    align-items: start;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .partner__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 0.5rem;
    background: var(--surface-alt);
    border-radius: var(--radius-sm);
  }
  .partner__logo img {
    max-height: 60px;
    width: auto;
    mix-blend-mode: multiply;
  }
  :root[data-theme='dark'] .partner__logo img {
    mix-blend-mode: normal;
  }
  .partner__logo span {
    font-weight: 700;
    text-align: center;
    font-size: var(--step--1);
  }
  .partner__body h2 {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .partner__body {
    font-size: var(--step--1);
  }
  @media (max-width: 38rem) {
    .partner {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .partner__logo {
      justify-content: flex-start;
      background: transparent;
      padding: 0;
    }
  }
</style>
