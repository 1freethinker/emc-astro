---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing pages/home.md');
const { Content } = await render(home);
const { hero, highlights, gallery } = home.data;

// Line icons for the "How EMC helps" cards. 24x24, stroke = currentColor.
const icons: Record<string, string> = {
  crisis: `<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.4"/><path d="m6 6 3.6 3.6M18 6l-3.6 3.6M6 18l3.6-3.6M18 18l-3.6-3.6"/>`,
  supplies: `<path d="M21 8.5 12 4 3 8.5v7L12 20l9-4.5z"/><path d="M3 8.5 12 13l9-4.5M12 13v7M7.5 6.2l9 4.5"/>`,
  immigration: `<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.6 2.6 14.4 0 17M12 3.5c-2.6 2.6-2.6 14.4 0 17"/>`,
  counseling: `<path d="M20 11.5a7 7 0 0 1-7 7H8l-4 3v-3.5A7 7 0 0 1 11 4.5h2a7 7 0 0 1 7 7z"/><path d="M9 11.5h.01M12 11.5h.01M15 11.5h.01"/>`,
};
---

<BaseLayout title={home.data.navLabel ?? 'Home'} description={home.data.description}>
  {
    hero && (
      <section class="hero">
        <div class="container hero__inner">
          <div class="hero__copy">
            <h1>{hero.heading}</h1>
            {hero.subheading && <p class="hero__lede">{hero.subheading}</p>}
            {hero.ctas.length > 0 && (
              <p class="hero__ctas">
                {hero.ctas.map((c, i) => (
                  <a class:list={['btn', { 'btn--secondary': i > 0 }]} href={c.href}>
                    {c.label}
                  </a>
                ))}
              </p>
            )}
          </div>
          {hero.image && (
            <div class="hero__media">
              <Image src={hero.image} alt="" width={560} format="webp" fetchpriority="high" />
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="section mission">
    <div class="container mission__inner">
      <div class="prose">
        <Content />
      </div>
      <p class="mission__actions">
        <a class="link-arrow" href="/emergency-support">Need urgent help? Emergency support</a>
      </p>
    </div>
  </section>

  {
    highlights && highlights.length > 0 && (
      <section class="section band">
        <div class="container">
          <h2 class="band__title">How EMC helps</h2>
          <ul class="highlights">
            {highlights.map((h) => (
              <li class="card">
                {h.icon && icons[h.icon] && (
                  <span class="card__icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={icons[h.icon]}
                    />
                  </span>
                )}
                <h3>{h.title}</h3>
                <p>{h.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    gallery && gallery.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="gallery__title">EMC in action</h2>
          <div class="gallery">
            {gallery.map((src) => (
              <Image src={src} alt="" width={360} format="webp" loading="lazy" />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    background: linear-gradient(160deg, var(--hero-from), var(--hero-to));
    border-bottom: 1px solid var(--border);
  }
  .hero__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
    align-items: center;
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }
  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: max-content auto minmax(0, 1fr);
    }
  }
  .hero__copy h1 {
    font-family: var(--font-logo);
    font-size: var(--step-5);
    font-weight: 700;
    max-width: 12ch;
  }
  .hero__lede {
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 32ch;
    text-wrap: balance;
  }
  .hero__ctas {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .hero__media img {
    width: clamp(19rem, 36vw, 28rem);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    filter: url(#illustrate-photo);
  }
  @media (max-width: 51.99rem) {
    .hero__media img {
      width: 100%;
      max-width: 30rem;
    }
  }

  /* ---- Mission ---- */
  .mission__inner {
    max-width: var(--container-narrow);
  }
  .mission :global(h2) {
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }
  .mission :global(p) {
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .mission__actions {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }
  .link-arrow {
    font-weight: 700;
    text-decoration: none;
    color: var(--link);
  }
  .link-arrow::after {
    content: ' →';
    white-space: nowrap;
  }
  .link-arrow:hover {
    color: var(--link-hover);
  }

  /* ---- Highlights band ---- */
  .band {
    background: var(--surface-alt);
    border-block: 1px solid var(--border);
  }
  .band__title {
    font-size: var(--step-3);
    margin-bottom: 2rem;
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-pill);
    background: var(--rose-100);
    color: var(--primary);
  }
  .card__icon svg {
    width: 1.55rem;
    height: 1.55rem;
  }
  .card h3 {
    font-size: var(--step-1);
    margin: 1rem 0 0.5rem;
  }
  .card p {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* ---- Gallery ---- */
  .gallery__title {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .gallery {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 44rem) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-alt);
  }
</style>
