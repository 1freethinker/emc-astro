---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing pages/home.md');
const { Content } = await render(home);
const { hero, highlights, gallery } = home.data;
---

<BaseLayout title={home.data.navLabel ?? 'Home'} description={home.data.description}>
  {
    hero && (
      <section class="hero">
        <div class="container hero__inner">
          <div class="hero__copy">
            <h1>{hero.heading}</h1>
            {hero.subheading && <p class="hero__lede">{hero.subheading}</p>}
            {hero.ctas.length > 0 && (
              <p class="hero__ctas">
                {hero.ctas.map((c, i) => (
                  <a class:list={['btn', { 'btn--secondary': i > 0 }]} href={c.href}>
                    {c.label}
                  </a>
                ))}
              </p>
            )}
          </div>
          {hero.image && (
            <div class="hero__media">
              <img src={hero.image} alt="" width="495" height="400" fetchpriority="high" />
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="section mission">
    <div class="container mission__inner">
      <div class="prose">
        <Content />
      </div>
      <p class="mission__actions">
        <a class="link-arrow" href="/emergency-support">Need urgent help? Emergency support</a>
      </p>
    </div>
  </section>

  {
    highlights && highlights.length > 0 && (
      <section class="section band">
        <div class="container">
          <h2 class="band__title">How EMC helps</h2>
          <ul class="highlights">
            {highlights.map((h, i) => (
              <li class="card">
                <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{h.title}</h3>
                <p>{h.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    gallery && gallery.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="gallery__title">EMC in action</h2>
          <div class="gallery">
            {gallery.map((src) => (
              <img src={src} alt="" loading="lazy" />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    background: linear-gradient(160deg, var(--hero-from), var(--hero-to));
    border-bottom: 1px solid var(--border);
  }
  .hero__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
    align-items: center;
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }
  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: max-content auto minmax(0, 1fr);
    }
  }
  .hero__copy h1 {
    font-size: var(--step-5);
    font-style: italic;
    max-width: 12ch;
  }
  .hero__lede {
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 32ch;
    text-wrap: balance;
  }
  .hero__ctas {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .hero__media img {
    width: clamp(19rem, 36vw, 28rem);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  @media (max-width: 51.99rem) {
    .hero__media img {
      width: 100%;
      max-width: 30rem;
    }
  }

  /* ---- Mission ---- */
  .mission__inner {
    max-width: var(--container-narrow);
  }
  .mission :global(h2) {
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }
  .mission :global(p) {
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .mission__actions {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }
  .link-arrow {
    font-weight: 700;
    text-decoration: none;
    color: var(--link);
  }
  .link-arrow::after {
    content: ' →';
    white-space: nowrap;
  }
  .link-arrow:hover {
    color: var(--link-hover);
  }

  /* ---- Highlights band ---- */
  .band {
    background: var(--surface-alt);
    border-block: 1px solid var(--border);
  }
  .band__title {
    font-size: var(--step-3);
    margin-bottom: 2rem;
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }
  .card__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--primary);
    line-height: 1;
  }
  .card h3 {
    font-size: var(--step-1);
    margin: 0.75rem 0 0.5rem;
  }
  .card p {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* ---- Gallery ---- */
  .gallery__title {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .gallery {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 44rem) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-alt);
  }
</style>
