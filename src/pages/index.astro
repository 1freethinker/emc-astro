---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing pages/home.md');
const { Content } = await render(home);
const { hero, highlights, gallery } = home.data;
---

<BaseLayout title={home.data.navLabel ?? 'Home'} description={home.data.description}>
  {
    hero && (
      <section class="hero">
        <div class="container hero__inner">
          <div class="hero__copy">
            <h1>{hero.heading}</h1>
            {hero.subheading && <p class="hero__lede">{hero.subheading}</p>}
            {hero.ctas.length > 0 && (
              <p class="hero__ctas">
                {hero.ctas.map((c, i) => (
                  <a class:list={['btn', { 'btn--secondary': i > 0 }]} href={c.href}>
                    {c.label}
                  </a>
                ))}
              </p>
            )}
          </div>
          {hero.image && (
            <div class="hero__media">
              <img src={hero.image} alt="" width="495" height="400" fetchpriority="high" />
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container prose mission">
      <Content />
    </div>
  </section>

  {
    highlights && highlights.length > 0 && (
      <section class="section band">
        <div class="container">
          <ul class="highlights">
            {highlights.map((h) => (
              <li class="card">
                <h3>{h.title}</h3>
                <p>{h.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    gallery && gallery.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="gallery__title">EMC in action</h2>
          <div class="gallery">
            {gallery.map((src) => (
              <img src={src} alt="" loading="lazy" />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(160deg, var(--hero-from), var(--hero-to));
    border-bottom: 1px solid var(--border);
  }
  .hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
  .hero__copy h1 {
    font-size: var(--step-5);
    font-style: italic;
  }
  .hero__lede {
    margin-top: 1rem;
    font-size: var(--step-1);
    color: var(--text-muted);
    white-space: pre-line;
    max-width: 28ch;
  }
  .hero__ctas {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .hero__media img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    object-fit: cover;
  }

  .mission :global(h2) {
    font-size: var(--step-3);
  }
  .mission :global(h2:first-child) {
    margin-bottom: 0.5rem;
  }

  .band {
    background: var(--surface-alt);
    border-block: 1px solid var(--border);
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .card h3 {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
  }
  .card p {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .gallery__title {
    margin-bottom: 1.5rem;
  }
  .gallery {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-alt);
  }
</style>
