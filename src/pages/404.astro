---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="wrap page">
    <h1>Page not found</h1>
    <p>Sorry, we couldn't find that page. Try the <a href="/">home page</a>.</p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 3rem;
    min-height: 40vh;
  }
</style>
