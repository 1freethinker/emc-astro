---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TeamGrid from '../components/TeamGrid.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import MediaCoverageList from '../components/MediaCoverageList.astro';
import NewsList from '../components/NewsList.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((p) => p.id !== 'home')
    .map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { title, description, heroImage, rendersCollection, reviewNotes } = page.data;
---

<BaseLayout title={page.data.navLabel ?? title} description={description}>
  <div class="page-head">
    <div class="container">
      <Breadcrumbs current={page.id} />
      <h1>{title}</h1>
      {description && <p class="page-head__desc">{description}</p>}
    </div>
  </div>

  <div class="container page-body">
    {
      import.meta.env.DEV && reviewNotes && (
        <aside class="review-note">
          <strong>Migration note (dev only):</strong> {reviewNotes}
        </aside>
      )
    }

    {heroImage && (
      <img class="page-hero" src={heroImage} alt="" loading="lazy" />
    )}

    <div class="prose">
      <Content />
    </div>

    {rendersCollection === 'team' && <div class="collection"><TeamGrid /></div>}
    {rendersCollection === 'partners' && <div class="collection"><PartnerGrid /></div>}
    {rendersCollection === 'mediaCoverage' && <div class="collection"><MediaCoverageList /></div>}
    {rendersCollection === 'news' && <div class="collection"><NewsList /></div>}
  </div>
</BaseLayout>

<style>
  .page-head {
    background: linear-gradient(160deg, var(--hero-from), var(--hero-to));
    border-bottom: 1px solid var(--border);
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }
  .page-head h1 {
    margin-top: 0.75rem;
  }
  .page-head__desc {
    margin-top: 0.75rem;
    max-width: 52ch;
    color: var(--text-muted);
    font-size: var(--step-1);
  }

  .page-body {
    padding-block: var(--section-y);
  }
  .page-hero {
    width: 100%;
    max-height: 24rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
    background: var(--surface-alt);
  }
  .prose:empty {
    display: none;
  }
  .collection {
    margin-top: 2.5rem;
  }
  .prose:empty + .collection {
    margin-top: 0;
  }

  .review-note {
    border-left: 3px solid var(--primary);
    background: var(--surface-alt);
    padding: 0.85rem 1rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-bottom: 1.75rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
